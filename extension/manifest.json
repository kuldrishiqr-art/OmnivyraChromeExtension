{
  "manifest_version": 3,
  "name": "Omnivyra - Multi-Platform Social Intelligence",
  "version": "1.0.0",
  "description": "Advanced social intelligence hub for LinkedIn and YouTube analytics",

  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "alarms"
  ],

  "host_permissions": [
    "*://www.linkedin.com/*",
    "*://www.youtube.com/*",
    "*://api.omnivyra.io/*"
  ],

  "background": {
    "service_worker": "background/serviceWorker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "*://www.linkedin.com/*",
        "*://www.youtube.com/*"
      ],
      "js": [
        "core/eventBus.js",
        "storage/storageManager.js",
        "core/authBridge.js",
        "core/apiClient.js",
        "core/commandProcessor.js",
        "core/syncEngine.js",
        "core/syncTrigger.js",
        "platforms/linkedin/index.js",
        "platforms/youtube/index.js",
        "content_scripts/main.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "core/eventBus.js",
        "core/authBridge.js",
        "core/apiClient.js",
        "core/commandProcessor.js",
        "core/syncEngine.js",
        "core/syncTrigger.js",
        "storage/storageManager.js",
        "platforms/linkedin/index.js",
        "platforms/linkedin/scraper.js",
        "platforms/youtube/index.js",
        "content_scripts/main.js"
      ],
      "matches": [
        "*://www.linkedin.com/*",
        "*://www.youtube.com/*"
      ]
    }
  ],

  "action": {
    "default_title": "Omnivyra Intelligence",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },

  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}